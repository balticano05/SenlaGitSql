<?xml version="1.0" encoding="UTF-8"?>   
<databaseChangeLog
   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xmlns:pro="http://www.liquibase.org/xml/ns/pro"
   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd
      http://www.liquibase.org/xml/ns/pro 
      http://www.liquibase.org/xml/ns/pro/liquibase-pro-4.1.xsd"
      logicalFilePath="changelogs/homework-2">

    <changeSet id="homework-2-roles" author="Aleksey Yasiukevich">
        <createTable tableName="roles">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="varchar(40)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="VARCHAR"/>
        </createTable>
    </changeSet>

    <changeSet id="homework-2-users" author="Aleksey Yasiukevich">
        <sqlFile encoding="utf8" path="sql/02.create-users-table.sql" relativeToChangelogFile="true"/>
    </changeSet>

    <changeSet id="homework-2-role-idx" author="Aleksey Yasiukevich">
        <createIndex indexName="idx_role_id" tableName="users">
            <column name="role_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="homework-2-courses" author="Aleksey Yasiukevich">
        <sqlFile encoding="utf8" path="sql/04.create-courses-table.sql" relativeToChangelogFile="true"/>
    </changeSet>

    <changeSet id="homework-2-plans" author="Aleksey Yasiukevich">
        <createTable tableName="course_plans">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="lesson_count" type="INTEGER">
                <constraints nullable="false" checkConstraint="lesson_count >= 0"/>
            </column>
            <column name="practice_count" type="INTEGER">
                <constraints nullable="false" checkConstraint="practice_count >= 0"/>
            </column>
            <column name="duration" type="INTEGER">
                <constraints nullable="false" checkConstraint="duration >= 0"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_course_plans_courses"
                baseTableName="course_plans"
                baseColumnNames="id"
                referencedTableName="courses"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="homework-2-categories" author="Aleksey Yasiukevich">
        <sqlFile encoding="utf8" path="sql/06.create-categories-table.sql" relativeToChangelogFile="true"/>
    </changeSet>

    <changeSet id="homework-2-reviews" author="Aleksey Yasiukevich">
        <createTable tableName="reviews">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="course_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="VARCHAR"/>
            <column name="rating" type="INTEGER">
                <constraints nullable="false" checkConstraint="rating >= 0"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_reviews_users"
                baseTableName="reviews"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                constraintName="fk_reviews_courses"
                baseTableName="reviews"
                baseColumnNames="course_id"
                referencedTableName="courses"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="homework-2-course-category" author="Aleksey Yasiukevich">
        <sqlFile encoding="utf8" path="sql/08.create-course-categories-table.sql" relativeToChangelogFile="true"/>
    </changeSet>

    <changeSet id="homework-2-transactions" author="Aleksey Yasiukevich">
        <createTable tableName="transactions">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="course_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="datetime" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_transactions_users"
                baseTableName="transactions"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                constraintName="fk_transactions_courses"
                baseTableName="transactions"
                baseColumnNames="course_id"
                referencedTableName="courses"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="homework-2-insert-roles" author="Aleksey Yasiukevich">
        <sqlFile encoding="utf8" path="sql/10.insert-roles.sql" relativeToChangelogFile="true"/>
    </changeSet>

    <changeSet id="homework-2-insert-users" author="Aleksey Yasiukevich">
        <sqlFile encoding="utf8" path="sql/11.insert-users.sql" relativeToChangelogFile="true"/>
    </changeSet>

    <changeSet id="homework-2-insert-courses" author="Aleksey Yasiukevich">
        <sqlFile encoding="utf8" path="sql/12.insert-courses.sql" relativeToChangelogFile="true"/>
    </changeSet>

    <changeSet id="homework-2-insert-course-plans" author="Aleksey Yasiukevich">
        <sqlFile encoding="utf8" path="sql/13.insert-course-plans.sql" relativeToChangelogFile="true"/>
    </changeSet>

    <changeSet id="homework-2-insert-categories" author="Aleksey Yasiukevich">
        <sqlFile encoding="utf8" path="sql/14.insert-categories.sql" relativeToChangelogFile="true"/>
    </changeSet>

    <changeSet id="homework-2-insert-reviews" author="Aleksey Yasiukevich">
        <sqlFile encoding="utf8" path="sql/15.insert-reviews.sql" relativeToChangelogFile="true"/>
    </changeSet>

    <changeSet id="homework-2-insert-course-categories" author="Aleksey Yasiukevich">
        <sqlFile encoding="utf8" path="sql/16.insert-course-categories.sql" relativeToChangelogFile="true"/>
    </changeSet>

    <changeSet id="homework-2-insert-transactions" author="Aleksey Yasiukevich">
        <sqlFile encoding="utf8" path="sql/17.insert-transactions.sql" relativeToChangelogFile="true"/>
    </changeSet>

</databaseChangeLog> 
